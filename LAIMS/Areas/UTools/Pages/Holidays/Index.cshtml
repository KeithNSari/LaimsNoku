@page
@model LAIMS.Areas.UTools.Pages.Holidays.IndexModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h2>Add Holiday</h2>
<div class="row mb-3">
    <form method="post">
        <div class="row mb-3">
            <div class="form-group">
                <label asp-for="Holiday.HolidayName"><b>Holiday</b></label>
                <input asp-for="Holiday.HolidayName" class="form-control" />
                <span asp-validation-for="Holiday.HolidayName" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Holiday.HolidayDate"><b>Holiday Date</b></label>
                    <input asp-for="Holiday.HolidayDate" type="date" class="form-control" />
                    <span asp-validation-for="Holiday.HolidayDate" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Holiday.NextBillingDate"><b>Next Billing Date</b></label>
                    <input asp-for="Holiday.NextBillingDate" type="date" class="form-control" />
                    <span asp-validation-for="Holiday.NextBillingDate" class="text-danger"></span>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-primary float-end">Save</button>
    </form>
</div>
<div class="row mb-3"> 
    <table class="table table-striped">
        <tr> 
            <th class="col-md-1">Year</th>
            <th class="col-md-4">Name</th>
            <th class="col-md-3">Date</th>
            <th class="col-md-3">Next Billing Date</th>
            <th class="col-md-1"></th>
        </tr>
        @foreach (var holiday in Model.HolidayList)
        {
            <tr>
                <td>@holiday.Year</td>
                <td>@holiday.HolidayName</td>
                <td>@holiday.HolidayDate.ToShortDateString()</td>
                <td>@holiday.NextBillingDate.ToShortDateString()</td>
                <td>
                    <form method="post" asp-page-handler="Archive" asp-route-id="@holiday.HolidayID">
                        <button type="submit" class="btn btn-danger">Archive</button>
                    </form>
                </td>
            </tr>
        }
    </table>
</div>
