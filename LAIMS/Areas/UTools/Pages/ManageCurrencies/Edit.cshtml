@page
@using Microsoft.AspNetCore.Http.Extensions;
@model LAIMS.Areas.UTools.Pages.ManageCurrencies.EditModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h2>Add Currencies</h2>
@if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
{
    <p class="text-danger">@ViewData["ErrorMessage"]</p>
}
<hr />
<div class="row">
    @* <div class="col-md-6"> *@
        <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Currency.CurrencyName" class="control-label"><b>Currency</b></label>
                <input asp-for="Currency.CurrencyName" class="form-control" maxlength="50" />
                <span asp-validation-for="Currency.CurrencyName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Currency.ShortCode" class="control-label"><b>Short Code</b></label>
                <input asp-for="Currency.ShortCode" class="form-control" maxlength="10" />
                <span asp-validation-for="Currency.ShortCode" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Currency.Default" class="control-label"><b>Default?</b></label>
                <select asp-for="Currency.Default" class="form-control" aria-required="true">
                    <option value="">Select Option</option>
                    <option value=0>No</option>
                    <option value=1>Yes</option>
                </select>
                <span asp-validation-for="Currency.Default" class="text-danger"></span>
            </div>
            <input type="submit" value="Edit" class="btn btn-primary" />
        </form>
    @* </div>  *@
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
} 