@page
@using System.Data
@model LAIMS.Areas.UTools.Pages.Rates.CoverRatesIndexModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h1>Cover Rates Files Upload</h1>
@if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
{
    <p class="text-danger">@ViewData["ErrorMessage"]</p>
}
<p>Please ensure that your file is an Excel workbook with the required columns and correct formats.</p>
<hr />
<form method="post" enctype="multipart/form-data">
    <h3>Upload Cover Rates File</h3>
    <div class="row mb-3">
        <div class="col-md-5">
            <label class="control-label"><b>Select file</b></label>
            <input class="form-control" required multiple="multiple" type="file" asp-for="Upload" />
        </div>
        <div class="col-md-5">
            <label asp-for="EffectiveDate" class="control-label"><b>Effective Date</b></label>
            <input asp-for="EffectiveDate" type="date" required class="form-control" />
            <span asp-validation-for="EffectiveDate" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <br />
            <input class="btn btn-primary" type="submit" value="Upload File" />
        </div>
    </div>
</form>
<form method="post">
@if ((Model.RatesDT != null) && (Model.RatesDT.Rows.Count > 0))
{
    @* <hr /> *@
    <div class="row mb-3">
        <table class="table table-hover">
            <tr>
                <th>BatchID</th>
                <th>Product</th>
                <th>Sum Assured</th>
                <th>Currency</th>
                <th>Effective</th>
                <th>Added On</th>
                <th></th>
            </tr>
            @foreach (DataRow DR in Model.RatesDT.Rows)
            {
                <tr>
                    <td>@DR["BatchID"]</td>
                    <td>@DR["Product"]</td>
                    <td>@DR["SumAssured"]</td>
                    <td>@DR["Currency"]</td>
                    <td>@DR["EffectiveDate"]</td>
                    <td>@DR["AddedOn"]</td>
                    <td> <button type="submit" asp-route-docId="@DR["MediaUploadID"]" asp-page-handler="DownloadFile" class="btn btn-success">Download</button></td>
                </tr>
            }
        </table>
    </div>
}
</form>