@page
@model LoginModel
@{
    Layout = "/Pages/Shared/_LayoutLogin.cshtml";
}
@{
    ViewData["Title"] = "Log in";
}  

    <div class="login-content">
        <section>
            <form id="account" method="post">
                <h1 class="text-center">LAIMS Sign In</h1>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                <h3 style="color: red;" class="class="text-center mb-4"">
                    <strong>Error:</strong> @Model.ErrorMessage
                  </h3>
                }
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="text-muted text-center mb-4">
                    Please verify your identity.
                </div>
                <div class="mb-3">
                <label asp-for="Input.Username" class="form-label"><b>Username</b></label>
                <input asp-for="Input.Username" class="form-control form-control-lg fs-15px" autocomplete="off" aria-required="true"/>
                <span asp-validation-for="Input.Username" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <div class="d-flex">
                    <label asp-for="Input.Password" class="form-label"><b>Password</b></label>
                </div>
                    @* <input type="password" class="form-control form-control-lg fs-15px" value="" placeholder="Enter your password"> *@
                    <input asp-for="Input.Password" class="form-control form-control-lg fs-15px" autocomplete="off" aria-required="true" placeholder="password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>  
               @*  <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div> *@
                <button id="login-submit" type="submit" class="btn btn-success btn-lg d-block w-100 fw-500 mb-3">Sign In</button>                 
            </form>
        </section>
    </div>
 
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
