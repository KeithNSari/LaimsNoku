@page
@using System.Data
@model LAIMS.Areas.PolicyServicing.Pages.Communication.IndexModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h1>Policy Servicing Notifications</h1>
<p>Latest notifications.</p>
<hr />
<div class="row mb-3">
    <table class="table table-hover">
        <tr>
            <th>ID</th>
            <th>Change Type</th>
            <th>Member Name</th>
            <th>Policy No</th> 
            <th>Message</th>
            <th>Added On</th>
        </tr>
        @if (Model.MessagesDT != null)
        {
            @foreach (DataRow DR in Model.MessagesDT.Rows)
            {
                <tr>
                    <td>@DR["ID"]</td>
                    <td>@DR["ChangeType"]</td>
                    <td>@DR["MemberName"]</td>
                    <td>@DR["PolicyNo"]</td> 
                    <td>@DR["Message"]</td>
                    <td>@DR["AddedOn"]</td>
                </tr>
            }
        }
    </table>
</div>