@page
@using System.Data
@model LAIMS.Areas.PolicyServicing.Pages.People.ReviewsModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutSearch.cshtml";
}
<h1>Changes Awaiting Approval</h1>
<hr /> 
@if (Model.MembersDT != null)
{
    <div class="row mb-3">
        <h5>@Model.ResultsCount result/s found for search "@Model.SearchTerm"!</h5>
    </div>
}
<div class="row mb-3">
    <table class="table table-hover">
        <tr>
            <th>Title</th>
            <th>Name 1</th>
            <th>Name 2</th>
            <th>Name 3</th>
            <th>Gender</th>
            <th>ID</th>
            <th>Status</th>
            <th></th>
        </tr>
        @if (Model.MembersDT != null)
        {
            @foreach (DataRow DR in Model.MembersDT.Rows)
            {
                <tr>
                    <td>@DR["Title"]</td>
                    <td>@DR["Name1"]</td>
                    <td>@DR["Name2"]</td>
                    <td>@DR["Name3"]</td>
                    <td>@DR["Gender"]</td>
                    <td>@DR["NationalID"]</td>
                    <td>@DR["Status"]</td>
                    <td class="text-end">
                        <a asp-page="Approval" asp-route-id="@DR["UID"]" asp-route-requestid="@DR["RequestID"]" class="btn btn-info btn-sm">Approve</a>
                    </td>
                </tr>
            }
        }
    </table>
</div>