@page
@model LAIMS.Areas.PolicyServicing.Pages.People.DetailsModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h2>Edit Member</h2>
<hr/>
@if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
{
    <p class="text-danger">@ViewData["ErrorMessage"]</p>
}
<div class="row mb-3">
    <h3>Original Record</h3>
    <hr />
    <table class="table table-hover">
        <tr>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
        </tr>
        <tr>
            <td><b>First Name:</b></td>
            <td>@Model.Member.Name1</td>
            <td><b>Middle Name:</b></td>
            <td>@Model.Member.Name2</td>
            <td><b>Surname:</b></td>
            <td>@Model.Member.Name3</td>
        </tr>
        <tr>
            <td><b>Gender:</b></td>
            <td>@Model.Member.Gender</td>
            <td><b>Title:</b></td>
            <td>@Model.Member.Title</td>
            <td><b>Marital Status:</b></td>
            <td>@Model.Member.MaritalStatus</td>
        </tr>
        <tr>
            <td><b>D.O.B:</b></td>
            <td>@Model.Member.DOB</td>
            <td><b>Birth Country:</b></td>
            <td>@Model.Member.BirthCountry</td>
            <td><b>Place Of Birth:</b></td>
            <td>@Model.Member.PlaceOfBirth</td>
        </tr>
        <tr>
            <td><b>Citizenship:</b></td>
            <td>@Model.Member.Country</td>
            <td><b>Member No:</b></td>
            <td>@Model.Member.MemberNo</td>
            <td><b>National ID:</b></td>
            <td>@Model.Member.NationalID</td>
        </tr>
        <tr>
            <td><b>Passport:</b></td>
            <td>@Model.Member.Passport</td>
            <td><b>Birth Certificate:</b></td>
            <td>@Model.Member.BirthCertificate</td>
            <td></td>
            <td></td>
        </tr>
    </table>
</div>

<div class="row mb-3">
    <h3>New Record</h3>
    <hr/>
    <table class="table table-hover">
        <tr>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
        </tr>
        <tr>
            <td><b>First Name:</b></td>
            <td>@Model.StagingMember.Name1</td>
            <td><b>Middle Name:</b></td>
            <td>@Model.StagingMember.Name2</td>
            <td><b>Surname:</b></td>
            <td>@Model.StagingMember.Name3</td>
        </tr>
        <tr>
            <td><b>Gender:</b></td>
            <td>@Model.StagingMember.Gender</td>
            <td><b>Title:</b></td>
            <td>@Model.StagingMember.Title</td>
            <td><b>Marital Status:</b></td>
            <td>@Model.StagingMember.MaritalStatus</td>
        </tr>
        <tr>
            <td><b>D.O.B:</b></td>
            <td>@Model.StagingMember.DOB</td>
            <td><b>Birth Country:</b></td>
            <td>@Model.StagingMember.BirthCountry</td>
            <td><b>Place Of Birth:</b></td>
            <td>@Model.StagingMember.PlaceOfBirth</td>
        </tr>
        <tr>
            <td><b>Citizenship:</b></td>
            <td>@Model.StagingMember.Country</td>
            <td><b>Member No:</b></td>
            <td>@Model.StagingMember.MemberNo</td>
            <td><b>National ID:</b></td>
            <td>@Model.StagingMember.NationalID</td>
        </tr>
        <tr>
            <td><b>Passport:</b></td>
            <td>@Model.StagingMember.Passport</td>
            <td><b>Birth Certificate:</b></td>
            <td>@Model.StagingMember.BirthCertificate</td>
            <td></td>
            <td></td>
        </tr>
    </table>
</div>
      