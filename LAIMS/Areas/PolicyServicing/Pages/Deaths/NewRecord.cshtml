@page
@using System.Data;
@model LAIMS.Areas.PolicyServicing.Pages.Deaths.NewRecordModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h2>Details of Deceased</h2> 
<hr/>
@if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
{
    <p class="text-danger">@ViewData["ErrorMessage"]</p>
}
<div class="row mb-3"> 
    <table class="table table-hover">
        <tr>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
        </tr>
        <tr>
            <td><b>First Name:</b></td>
            <td>@Model.Member.Name1</td>
            <td><b>Middle Name:</b></td>
            <td>@Model.Member.Name2</td>
            <td><b>Surname:</b></td>
            <td>@Model.Member.Name3</td>
        </tr>
        <tr>
            <td><b>Gender:</b></td>
            <td>@Model.Member.Gender</td>
            <td><b>Title:</b></td>
            <td>@Model.Member.Title</td>
            <td><b>Marital Status:</b></td>
            <td>@Model.Member.MaritalStatus</td>
        </tr>
        <tr>
            <td><b>D.O.B:</b></td>
            <td>@Model.Member.DOB</td>
            <td><b>Birth Country:</b></td>
            <td>@Model.Member.BirthCountry</td>
            <td><b>Place Of Birth:</b></td>
            <td>@Model.Member.PlaceOfBirth</td>
        </tr>
        <tr>
            <td><b>Citizenship:</b></td>
            <td>@Model.Member.Country</td>
            <td><b>Member No:</b></td>
            <td>@Model.Member.MemberNo</td>
            <td><b>National ID:</b></td>
            <td>@Model.Member.NationalID</td>
        </tr>
        <tr>
            <td><b>Passport:</b></td>
            <td>@Model.Member.Passport</td>
            <td><b>Birth Certificate:</b></td>
            <td>@Model.Member.BirthCertificate</td>
            <td></td>
            <td></td>
        </tr>
    </table>
</div>
<h4>Add Details</h4>
<hr/>
<form method="post"> 
    <input type="hidden" asp-for="MemberUID" />
<div class="row mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="DeathRecord.EventCauseID" class="control-label"><b>Cause Of Death</b></label>
                <select asp-for="DeathRecord.EventCauseID" required asp-items="Model.EventTypeCauseList" class="form-control" aria-required="true" onchange="toggleHealthAffectedDate()">
                    <option value="">Select Option</option>
                </select>
                <span asp-validation-for="DeathRecord.EventCauseID" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="BurialOrderNo"><b>Burial Order:</b></label>
                <input type="text" class="form-control" asp-for="DeathRecord.BurialOrderNo" />
                <span asp-validation-for="DeathRecord.BurialOrderNo" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label for="DeathCertificateNo"><b>Death Certificate:</b></label>
                <input type="text" class="form-control" asp-for="DeathRecord.DeathCertificateNo" />
                <span asp-validation-for="DeathRecord.DeathCertificateNo" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="DateOfDeath"><b>Date of Death:*</b></label>
                <input type="date" required class="form-control" asp-for="DeathRecord.DateOfDeath" />
                <span asp-validation-for="DeathRecord.DateOfDeath" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label for="CauseDetails"><b>Cause Details:</b></label>
                <input type="text" class="form-control" asp-for="DeathRecord.CauseDetails" />
                <span asp-validation-for="DeathRecord.CauseDetails" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="DateHealthAffected" id="dateHealthAffectedLbl"><b>Date Health Affected:</b></label>
                <input type="date" class="form-control" asp-for="DeathRecord.DateHealthAffected" />
                <span asp-validation-for="DeathRecord.DateHealthAffected" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label for="Place"><b>Place of Death*:</b></label>
                <input type="text" class="form-control" required asp-for="DeathRecord.Place" />
                <span asp-validation-for="DeathRecord.Place" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="Hospital"><b>Hospital:</b></label>
                <input type="text" class="form-control" asp-for="DeathRecord.Hospital" />
                <span asp-validation-for="DeathRecord.Hospital" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label for="PoliceStation"><b>Police Station:</b></label>
                <input type="text" class="form-control" asp-for="DeathRecord.PoliceStation" />
                <span asp-validation-for="DeathRecord.PoliceStation" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="CaseReferenceNo"><b>Case Reference No:</b></label>
                <input type="text" class="form-control" asp-for="DeathRecord.CaseReferenceNo" />
                <span asp-validation-for="DeathRecord.CaseReferenceNo" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>
<div class="row mb-3">
    <div class="col-md-8">
    </div>
    <div class="col-md-2">
    </div>
    <div class="col-md-2">
        <button class="btn btn-success" type="submit">Submit</button>
    </div>
</div>
</form> 