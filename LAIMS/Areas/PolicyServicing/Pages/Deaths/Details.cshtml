@page
@using System.Data;
@model LAIMS.Areas.PolicyServicing.Pages.Deaths.DetailsModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h2>Details of Deceased</h2>
<hr />
@if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
{
    <p class="text-danger">@ViewData["ErrorMessage"]</p>
}
<div class="row mb-3">
    <table class="table table-hover">
        <tr>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
            <th class="col-md-2"></th>
        </tr>
        <tr>
            <td><b>First Name:</b></td>
            <td>@Model.Member.Name1</td>
            <td><b>Middle Name:</b></td>
            <td>@Model.Member.Name2</td>
            <td><b>Surname:</b></td>
            <td>@Model.Member.Name3</td>
        </tr>
        <tr>
            <td><b>Gender:</b></td>
            <td>@Model.Member.Gender</td>
            <td><b>Title:</b></td>
            <td>@Model.Member.Title</td>
            <td><b>Marital Status:</b></td>
            <td>@Model.Member.MaritalStatus</td>
        </tr>
        <tr>
            <td><b>D.O.B:</b></td>
            <td>@Model.Member.DOB</td>
            <td><b>Birth Country:</b></td>
            <td>@Model.Member.BirthCountry</td>
            <td><b>Place Of Birth:</b></td>
            <td>@Model.Member.PlaceOfBirth</td>
        </tr>
        <tr>
            <td><b>Citizenship:</b></td>
            <td>@Model.Member.Country</td>
            <td><b>Member No:</b></td>
            <td>@Model.Member.MemberNo</td>
            <td><b>National ID:</b></td>
            <td>@Model.Member.NationalID</td>
        </tr>
        <tr>
            <td><b>Passport:</b></td>
            <td>@Model.Member.Passport</td>
            <td><b>Birth Certificate:</b></td>
            <td>@Model.Member.BirthCertificate</td>
            <td></td>
            <td></td>
        </tr>
    </table>
</div>
<h4>Death Record</h4>
<hr />
<div class="row mb-3">
    <div class="container">
        @foreach (var record in Model.DeathRecords)
        {
            <h3>Death Records for @record.MemberName</h3>
            <hr />
            <div class="row">
                <div class="col-md-3">
                    <strong>Date Health Affected:</strong> @(record.DateHealthAffected.HasValue ? record.DateHealthAffected.Value.ToString("yyyy-MM-dd") : "")
                </div>
                <div class="col-md-3">
                    <strong>Date Of Death:</strong> @record.DateOfDeath.ToString("yyyy-MM-dd")
                </div>
                <div class="col-md-3">
                    <strong>Event Cause:</strong> @record.EventCauseName
                </div>
                <div class="col-md-3">
                    <strong>Cause Details:</strong> @record.CauseDetails
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-3">
                    <strong>Place:</strong> @record.Place
                </div>
                <div class="col-md-3">
                    <strong>Hospital:</strong> @record.Hospital
                </div>
                <div class="col-md-3">
                    <strong>Police Station:</strong> @record.PoliceStation
                </div>
                <div class="col-md-3">
                    <strong>Case Reference No:</strong> @record.CaseReferenceNo
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-3">
                    <strong>Burial Order No:</strong> @record.BurialOrderNo
                </div>
                <div class="col-md-3">
                    <strong>Death Certificate No:</strong> @record.DeathCertificateNo
                </div>
                <div class="col-md-3">
                    <strong>Added By:</strong> @record.AddedBy
                </div>
                <div class="col-md-3">
                    <strong>Added On:</strong> @record.AddedOn.ToString("yyyy-MM-dd HH:mm:ss")
                </div>
            </div>
            <hr />
        }
    </div>
</div>
<h3>Affected Policies</h3>
<div class="row mb-3">
    <table class="table table-hover">
        <tr>
            <th>Policy</th>
            <th>PolicyNo</th>
            <th>Commencement</th>
            <th>Member Commencement</th>
            <th>Role</th>       
            <th>Status</th>
            <th>S. Date</th> 
        </tr>
        @if (Model.AssociatedPoliciesDT != null)
        {
            @foreach (DataRow DR in Model.AssociatedPoliciesDT.Rows)
            {
                <tr>
                    <td>@DR["PolicyTypeName"]</td>
                    <td>@DR["PolicyNo"]</td>
                    <td>@DR["PolicyCommencementDate"]</td>
                    <td>@DR["PolicyPremiumCommencementDate"]</td>                   
                    <td>@DR["Role"]</td>                   
                    <td>@DR["PolicyStatus"]</td>
                    <td>@DR["PolicyStatusDate"]</td> 
                </tr>
            }
        }
        </table>
</div>
