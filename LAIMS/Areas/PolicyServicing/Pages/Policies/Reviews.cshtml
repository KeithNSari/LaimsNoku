@page
@using System.Data
@model LAIMS.Areas.PolicyServicing.Pages.Policies.ReviewsModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutSearch.cshtml";
}
<h1>Changes Awaiting Approval</h1>
<hr /> 
<div class="row mb-3">
    <form method="post">
        <table class="table table-hover">
            <tr>
                <th>Entry </th>
                <th>Applied</th>
                <th>Policy No</th>
                <th>Policy</th>
                <th>Status</th>
                <th>Status Date</th>
                <th></th>
            </tr>
            @if (Model.PoliciesDT != null)
            {
                @foreach (DataRow DR in Model.PoliciesDT.Rows)
                {
                    <tr>
                        <td>@DR["EntryNo"]</td>
                        <td>@DR["AddedOn"]</td>
                        <td>@DR["PolicyNo"]</td>
                        <td>@DR["PolicyTypeName"]</td>
                        <td>@DR["Status"]</td>
                        <td>@DR["StatusDate"]</td>
                        <td class="text-end">
                            <a asp-route-id="@DR["UID"]" asp-route-policyTypeid="@DR["PolicyType"]" asp-route-policyid="@DR["ID"]" asp-route-reqid="@DR["RequestID"]" asp-page="Approval" class="btn btn-info btn-sm">Approve</a>
                        </td>
                    </tr>
                }
            }
        </table>
    </form>
</div>