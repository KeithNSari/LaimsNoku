@page
@using System.Data;
@model LAIMS.Areas.PolicyServicing.Pages.Policies.PPApprovalModel
@{
} 
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h1>Policy: Manage Premiums</h1>
<div class="bg-light">
    <hr />
    <h3>Policy: @Model.PolicyName</h3>
    <div class="nav-wizards-container">
        <nav class="nav nav-wizards-1 mb-2">
            <div class="nav-item col">
                <a class="nav-link completed" asp-page="SelectPolicy" asp-route-id="@Model.MemberID">
                    <div class="nav-no">1</div>
                    <div class="nav-text">Select Policy</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link completed" asp-page="NewApplication" asp-route-id="@Model.MemberID" asp-route-policyid="@Model.PolicyID" asp-route-policyTypeId="@Model.PolicyTypeID">
                    <div class="nav-no">2</div>
                    <div class="nav-text">Add Riders</div>
                </a>
            </div> 
            <div class="nav-item col">
                <a class="nav-link completed" href="#">
                    <div class="nav-no">3</div>
                    <div class="nav-text">Submission</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link active" href="#">
                    <div class="nav-no">4</div>
                    <div class="nav-text">Supervisor Approval</div>
                </a>
            </div>
        </nav>
    </div>
    <hr />
</div>
