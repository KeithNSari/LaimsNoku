@page
@model LAIMS.Areas.NewBusiness.Pages.policies.test2Model
@{
}
@{
    Layout = "/Pages/Shared/_LayoutNewBusiness.cshtml";
}
<!-- Your main page content -->
<!-- Button to open the modal -->
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#myModal">
    Open Modal
</button>

<!-- Your modal -->
<div class="modal fade" id="myModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Modal Title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Display the table in the modal form -->
                <table class="table">
                    <thead>
                        <!-- Assuming column names are known -->
                        <tr>
                            <th>Column 1</th>
                            <th>Column 2</th>
                            <!-- Add more header columns as needed -->
                        </tr>
                    </thead>
                    <tbody id="modalTableBody">
                        <!-- Table rows will be dynamically added here -->
                        @foreach (var row in Model.TabularData)
                        {
                            <tr>
                                <td>@row.Column1</td>
                                <td>@row.Column2</td>
                                <!-- Add more columns as needed -->
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- ... (unchanged form and button) -->
            </div>
        </div>
    </div>
</div>