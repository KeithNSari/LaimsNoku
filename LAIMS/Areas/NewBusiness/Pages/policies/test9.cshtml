@page
@model LAIMS.Areas.NewBusiness.Pages.policies.test9Model
@{
}
@{
    Layout = "/Pages/Shared/_LayoutNewBusiness.cshtml";
}
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#myModal" data-url="https://www.example1.com">
    Open Modal 1
</button>

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#myModal" data-url="https://www.example2.com">
    Open Modal 2
</button>

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#myModal" data-url="https://www.example3.com">
    Open Modal 3
</button>

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#myModal" data-url="http://www.example.com">
    Open Modal 4
</button>

<!-- Modal -->
<div class="modal" id="myModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Iframe Modal</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal Body with iframe -->
            <div class="modal-body">
                <iframe id="modalIframe" style="width: 100%; height: 400px;"></iframe>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#myModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var url = button.data('url');
                $('#modalIframe').attr('src', url);
            });
        });
    </script>
}
