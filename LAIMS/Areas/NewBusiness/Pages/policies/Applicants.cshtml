@page
@using System.Data;
@model LAIMS.Areas.NewBusiness.Pages.policies.ApplicantsModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h1>Application: Add Details</h1>
<div class="bg-light">
    <hr />
    <h3>Policy: @Model.PolicyName</h3>
    <div class="nav-wizards-container">
        <nav class="nav nav-wizards-1 mb-2">
            <div class="nav-item col">
                <a class="nav-link completed" asp-page="SelectPolicy" asp-route-id="@Model.MemberID">
                    <div class="nav-no">1</div>
                    <div class="nav-text">Select Policy</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link active" asp-page="Applicants" asp-route-id="@Model.MemberID" asp-route-policyid="@Model.PolicyID" asp-route-policyTypeId="@Model.PolicyTypeID">
                    <div class="nav-no">2</div>
                    <div class="nav-text">Add Details</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link disabled" href="#">
                    <div class="nav-no">3</div>
                    <div class="nav-text">Split</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link disabled" href="#">
                    <div class="nav-no">4</div>
                    <div class="nav-text">Documents</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link disabled" href="#">
                    <div class="nav-no">5</div>
                    <div class="nav-text">Questionnaires</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link disabled" href="#">
                    <div class="nav-no">6</div>
                    <div class="nav-text">Payments</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link disabled" href="#">
                    <div class="nav-no">7</div>
                    <div class="nav-text">Employment</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link disabled" href="#">
                    <div class="nav-no">8</div>
                    <div class="nav-text">Submission</div>
                </a>
            </div>
        </nav>
    </div>
    <hr />
</div>
<h3>Proposer</h3>
<table class="table table-hover">
    <tr>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
    </tr>
    <tr>
        <td><b>First Name:</b></td>
        <td>@Model.Member.Name1</td>
        <td><b>Middle Name:</b></td>
        <td>@Model.Member.Name2</td>
        <td><b>Surname:</b></td>
        <td>@Model.Member.Name3</td>
    </tr>
    <tr>
        <td><b>Gender:</b></td>
        <td>@Model.Member.Gender</td>
        <td><b>Title:</b></td>
        <td>@Model.Member.Title</td>
        <td><b>Marital Status:</b></td>
        <td>@Model.Member.MaritalStatus</td>
    </tr>
    <tr>
        <td><b>D.O.B:</b></td>
        <td>@Model.Member.DOB</td>
        <td><b>Birth Country:</b></td>
        <td>@Model.Member.BirthCountry</td>
        <td><b>Place Of Birth:</b></td>
        <td>@Model.Member.PlaceOfBirth</td>
    </tr>
    <tr>
        <td><b>Citizenship:</b></td>
        <td>@Model.Member.Country</td>
        <td><b>Member No:</b></td>
        <td>@Model.Member.MemberNo</td>
        <td><b>National ID:</b></td>
        <td>@Model.Member.NationalID</td>
    </tr>
    <tr>
        <td><b>Passport:</b></td>
        <td>@Model.Member.Passport</td>
        <td><b>Birth Certificate:</b></td>
        <td>@Model.Member.BirthCertificate</td>
        <td></td>
        <td></td>
    </tr>
</table>  
<button type="button" class="btn btn-success float-end fixed-width-btn" data-bs-toggle="modal" data-bs-target="#rolesModal">
    Add Roles
</button>
<br/>
<hr/>  
<!-- Modal -->
<form method="post">
    <div class="modal fade" id="rolesModal" tabindex="-1" aria-labelledby="rolesModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="rolesModalLabel">Add Roles</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h2></h2>
                    @if (TempData["PostbackSuccess"] != null && (bool)TempData["PostbackSuccess"])
                    {
                        <script>
                            closeModal('rolesModal');
                        </script>
                    }
                    <div class="row mb-3">
                        <div class="form-group">
                            <label>
                                <input type="checkbox" asp-for="@Model.IsPrincipalMember" />
                                <b>Principal Member</b>
                            </label>
                            <span asp-validation-for="@Model.IsPrincipalMember" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="form-group">
                            <label>
                                <input type="checkbox" asp-for="@Model.IsPremiumPayer" />
                                <b>Premium Payer</b>
                            </label>
                            <span asp-validation-for="@Model.IsPremiumPayer" class="text-danger"></span>
                        </div>
                    </div> 
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <input type="submit" value="Save Changes" asp-route-policyid="@Model.PolicyID" asp-route-id="@Model.MemberID" asp-route-policytypeid="@Model.PolicyTypeID" asp-page-handler="AddRoles" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </div>
</form>
<button type="button" class="btn btn-primary float-end fixed-width-btn" data-bs-toggle="modal" data-bs-target="#memberModal">
    Add Beneficiaries
</button>
<!-- Modal -->
<form method="post">
 <input type="hidden" asp-for="ReturnUrl" />
<div class="modal fade" id="memberModal" tabindex="-1" aria-labelledby="memberModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="memberModalLabel">Add Beneficiary</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h2></h2>
                @if (TempData["PostbackSuccess"] != null && (bool)TempData["PostbackSuccess"])
                {
                    <script>
                            closeModal('memberModal');
                    </script>
                } 
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="@Model.IDType" class="control-label"><b>ID Type</b></label>
                                <select asp-for="@Model.IDType" class="form-control" aria-required="true">
                                    <option value="">Select Option</option>
                                    <option value=1>National ID</option>
                                    <option value=2>Birth Certificate</option>
                                    <option value=3>Passport</option>
                                </select>
                                <span asp-validation-for="@Model.IDType" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="@Model.IDContent"><b>ID</b></label>
                                <input asp-for="@Model.IDContent" onpaste="return preventPaste(event)" class="form-control" autocomplete="off" />
                                <span asp-validation-for="@Model.IDContent" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="@Model.ConfirmIDContent"><b>Confirm ID</b></label>
                                <input asp-for="@Model.ConfirmIDContent" onpaste="return preventPaste(event)" class="form-control" autocomplete="off" />
                                <span asp-validation-for="@Model.ConfirmIDContent" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="NewMember.Name1"><b>First Name</b></label>
                                <input asp-for="NewMember.Name1" class="form-control" autocomplete="off" />
                                <span asp-validation-for="NewMember.Name1" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="NewMember.Name2"><b>Middle Name</b></label>
                                <input asp-for="NewMember.Name2" class="form-control" autocomplete="off" />
                                <span asp-validation-for="NewMember.Name2" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="NewMember.Name3"><b>Surname</b></label>
                                <input asp-for="NewMember.Name3" class="form-control" autocomplete="off" />
                                <span asp-validation-for="NewMember.Name3" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- Add other fields of the NewMember model... -->

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="NewMember.GenderID"><b>Gender</b></label>
                                <select asp-for="NewMember.GenderID" asp-items="Model.GenderList" class="form-control">
                                    <option value="">Select Gender</option>
                                </select>
                                <span asp-validation-for="NewMember.GenderID" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="NewMember.TitleID"><b>Title</b></label>
                                <select asp-for="NewMember.TitleID" asp-items="Model.TitleList" class="form-control" autocomplete="off">
                                    <option value="">Select Title</option>
                                </select>
                                <span asp-validation-for="NewMember.TitleID" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="NewMember.MaritalStatusID"><b>Marital Status</b></label>
                                <select asp-for="NewMember.MaritalStatusID" asp-items="Model.MaritalStatiiSelectList" class="form-control" autocomplete="off">
                                    <option value="">Select Status</option>
                                </select>
                                <span asp-validation-for="NewMember.MaritalStatusID" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="NewMember.DOB"><b>D.O.B</b></label>
                                <input asp-for="NewMember.DOB" type="date" class="form-control" autocomplete="off" />
                                <span asp-validation-for="NewMember.DOB" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="NewMember.BirthCountryID"><b>Birth Country</b></label>
                                <select asp-for="NewMember.BirthCountryID" asp-items="Model.CountrySelectList" class="form-control">
                                    <option value="">Select Birth Country</option>
                                </select>
                                <span asp-validation-for="NewMember.BirthCountryID" class="text-danger"></span>
                            </div>
                        </div>                       
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="NewMember.CountryID"><b>Citizenship</b></label>
                                <select asp-for="NewMember.CountryID" asp-items="Model.CountrySelectList" class="form-control">
                                    <option value="">Select Country</option>
                                </select>
                                <span asp-validation-for="NewMember.CountryID" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="@Model.RelationshipID"><b>Relationship</b></label>
                                <select asp-for="@Model.RelationshipID" class="form-control" asp-items="Model.MyRelationships">
                                    <option value="">Select Option</option>
                                </select>
                                <span asp-validation-for="@Model.RelationshipID" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="@Model.LIRoleID class=" control-label"><b>Role</b></label>
                                <select asp-for="@Model.LIRoleID" class="form-control">
                                    <option value="">Select Option</option>
                                    <option value=1>Principal Member</option>
                                    <option value=5>Beneficiary</option>
                                </select>
                                <span asp-validation-for="@Model.LIRoleID" class="text-danger"></span>
                            </div>
                        </div> 
                    </div>               
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button> 
                    <input type="submit" value="Save Changes" asp-route-policyid="@Model.PolicyID" asp-route-id="@Model.MemberID" asp-route-policytypeid="@Model.PolicyTypeID" asp-page-handler="AddBeneficiary" class="btn btn-primary" />
            </div>
        </div>
    </div>
</div>
</form> 
    <h2>Dependants List</h2>
    <div class="row mb-3">
        <table class="table table-striped">
            <tr>
                <th>Role</th>
                <th>Full Name</th>
                <th>R\ship</th>
                <th>D.O.B</th>
                <th>ID Type</th>
                <th>ID</th>
                <th></th>
            </tr>
            @if (Model.BeneficiariesDT != null)
            {
                @foreach (DataRow DR in Model.BeneficiariesDT.Rows)
                {
                    <tr>
                        <td>@DR["Role"]</td>
                        <td>@DR["FullName"]</td>
                        <td>@DR["Relationship"]</td>
                        <td>@DR["DOB"]</td>
                        <td>@DR["IDType"]</td>
                        <td>@DR["IDDocument"]</td>
                        <td class="text-end">
                        <button class="btn btn-primary inlineblockmbs" onclick="openCoverModal(@DR["ID"])">Add Premiums</button>
                        <form method="post" class="inlineblockmbs">
                            <a href='@Url.Page("/Membership/Edit", new { area = "NewBusiness",id=@DR["UID"] })' class="btn btn-outline-primary">Edit</a> 
                            <button type="submit" asp-page="Applicants" asp-route-policyid="@DR["PolicyID"]" asp-route-Id="@DR["ID"]" asp-route-memberid="@Model.MemberID" asp-route-policytypeid="@Model.PolicyTypeID" asp-page-handler="ArchiveBeneficiary" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to archive this item?');">X</button>
                        </form> 
                        </td>
                    </tr>
                }
            }
        </table>
    </div> 
<form method="post">
    <div class="modal fade" id="premiumsModal" tabindex="-1" aria-labelledby="premiumsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title" id="premiumsModalLabel">Add Premium</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h2></h2>
                    <input type="hidden" id="policyBeneficiaryid" asp-for="PolicyBeneficiaryLine.HeaderID"/>
                    @if (TempData["PostbackSuccess"] != null && (bool)TempData["PostbackSuccess"])
                    {
                        <script>
                            closeModal();
                        </script>
                    }
                    <div class="row mb-3"> 
                            <div class="form-group">
                            <label asp-for="PolicyBeneficiaryLine.ProductID" class="control-label" id="productLbl"><b>Product</b></label>
                            <select asp-for="PolicyBeneficiaryLine.ProductID" required class="form-control" asp-items="Model.MyProducts" onchange="toggleTextBox()">
                                <option value="">Select Product</option>
                            </select>
                            <span asp-validation-for="PolicyBeneficiaryLine.ProductID" class="text-danger"></span>
                            </div> 
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4" id="coverDiv">
                            <div class="form-group">
                                <label id="coverLbl" asp-for="PolicyBeneficiaryLine.Cover"><b>Cover</b></label>
                                <input asp-for="PolicyBeneficiaryLine.Cover" class="form-control" />
                                <span asp-validation-for="PolicyBeneficiaryLine.Cover" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PolicyBeneficiaryLine.Contribution"><b>Premium</b></label>
                                <input asp-for="PolicyBeneficiaryLine.Contribution" class="form-control" />
                                <span asp-validation-for="PolicyBeneficiaryLine.Contribution" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <input type="submit" value="Save Changes" asp-route-policyid="@Model.PolicyID" asp-route-id="@Model.MemberID" asp-route-policytypeid="@Model.PolicyTypeID" asp-page-handler="AddProductPremium" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </div>
</form>
<h2>Premiums</h2>
<hr/>
<div class="row mb-3">   
    <form method="post">
        @for (var i = 0; i < Model.PolicyBeneficiaryLineDetails.Count; i++)
        {
            var beneficiary = Model.PolicyBeneficiaryLineDetails[i];
            @if (i > 0 && (@Model.PolicyBeneficiaryLineDetails[i].Product != @Model.PolicyBeneficiaryLineDetails[i - 1].Product))
            {
                <h5>@beneficiary.Product</h5>
            }
            else if (i == 0)
            {
                <h5>@beneficiary.Product</h5>
            }
            <div>
                @if (i > 0 && (@Model.PolicyBeneficiaryLineDetails[i].Product != @Model.PolicyBeneficiaryLineDetails[i - 1].Product))
                {
                    <div class="row">
                        <div class="col-md-1"><b>LineID</b></div>
                        <div class="col-md-2"><b>Full Name</b></div>
                        <div class="col-md-1"><b>R\ship</b></div>
                        <div class="col-md-1"><b>DOB</b></div>
                        <div class="col-md-1"><b>IDType</b></div>
                        <div class="col-md-2"><b>ID</b></div>
                        <div class="col-md-2"><b>Premium (editable)</b></div>
                        @if (@Model.PolicyBeneficiaryLineDetails[i].CategoryID == 1) 
                        {
                            @* <div class="col-md-2"><b>Sum Assured (optional)</b></div> *@
                        }
                        else
                        {
                            <div class="col-md-2"><b>Cover (editable)</b></div>
                        }
                    </div>
                    <hr/>
                }
                else if (i == 0)
                {
                    <div class="row">
                        <div class="col-md-1"><b>LineID</b></div>
                        <div class="col-md-2"><b>Full Name</b></div>
                        <div class="col-md-1"><b>R/ship</b></div>
                        <div class="col-md-1"><b>DOB</b></div>
                        <div class="col-md-1"><b>IDType</b></div>
                        <div class="col-md-2"><b>ID</b></div>
                        <div class="col-md-2"><b>Premium (editable)</b></div>
                        @if (@Model.PolicyBeneficiaryLineDetails[i].CategoryID == 1) 
                        {
                           // <div class="col-md-2"><b>Sum Assured (optional)</b></div>
                        }
                        else
                        {
                            <div class="col-md-2"><b>Cover (editable)</b></div>
                        }                   
                    </div>
                    <hr />
                }
                @if (i % 2 == 0)
                {
                    <div class="row bg-light">
                        <div class="col-md-1">
                            <input type="hidden" asp-for="@Model.PolicyBeneficiaryLineDetails[i].LineId" />
                            @beneficiary.LineId
                        </div>
                        <div class="col-md-2">@beneficiary.FullName</div>
                        <div class="col-md-1">@beneficiary.Relationship</div>
                        <div class="col-md-1">@beneficiary.DOB.ToShortDateString()</div>
                        <div class="col-md-1">@beneficiary.IDType</div>
                        <div class="col-md-2">@beneficiary.ID</div>
                        <div class="col-md-2">
                            <input type="text" asp-for="@Model.PolicyBeneficiaryLineDetails[i].Premium" class="premium-input" />
                        </div> 
                        <div class="col-md-2">
                            @if (@Model.PolicyBeneficiaryLineDetails[i].CategoryID == 1)
                            {
                                @* <input type="text" asp-for="@Model.PolicyBeneficiaryLineDetails[i].Cover"/> *@
                            }
                            else
                            {
                                <input type="text" asp-for="@Model.PolicyBeneficiaryLineDetails[i].Cover" class="cover-input" />
                            }
                        </div>                         
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-md-1">
                            <input type="hidden" asp-for="@Model.PolicyBeneficiaryLineDetails[i].LineId" />
                            @beneficiary.LineId
                        </div>
                        <div class="col-md-2">@beneficiary.FullName</div>
                        <div class="col-md-1">@beneficiary.Relationship</div>
                        <div class="col-md-1">@beneficiary.DOB.ToString("yyyy-MM-dd")</div>
                        <div class="col-md-1">@beneficiary.IDType</div>
                        <div class="col-md-2">@beneficiary.ID</div>
                        <div class="col-md-2">
                            <input type="text" asp-for="@Model.PolicyBeneficiaryLineDetails[i].Premium" class="premium-input" />
                        </div>
                        <div class="col-md-2">
                            @if (@Model.PolicyBeneficiaryLineDetails[i].CategoryID == 1)
                            {
                               //<input type="text" asp-for="@Model.PolicyBeneficiaryLineDetails[i].Cover"/>
                            }
                            else
                            {
                               <input type="text" asp-for="@Model.PolicyBeneficiaryLineDetails[i].Cover" class="cover-input" />
                            }
                        </div>                  
                    </div>
                }
               
            </div>
            <br />
        }
        <div class="row">
            <div class="col-md-8">

            </div>
            <div class="col-md-2">            
                <b>Total Premium:</b>
            </div>
            <div class="col-md-2">
                 <span id="totalPremiumAmount">0.00</span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-8">
            </div>
            <div class="col-md-2">
                <b>Total Cover:</b>
            </div>
             <div class="col-md-2">
                <span id="totalCoverAmount">0.00</span>
             </div>
        </div> 
        <button type="submit" asp-route-policyid="@Model.PolicyID" asp-route-id="@Model.MemberID" asp-route-policytypeid="@Model.PolicyTypeID" asp-page-handler="UpdatePremiums" class="btn btn-primary fixed-width-btn float-end">Save Premium Changes</button>        
    </form>    
</div>

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="row mb-3">
        <div class="col-md-2">
            @if (Model.MinimumTerm > 0)
            {
                <b>Policy Term:</b>
            }
            
        </div>
        <div class="col-md-2">
            @if (Model.MinimumTerm > 0)
            {
                <input type="number" asp-for="@Model.PolicyTerm" min="1" />
            }            
        </div> 
        <div class="col-md-8">
            <button type="Next" asp-route-policyid="@Model.PolicyID" asp-route-id="@Model.MemberID" asp-route-policytypeid="@Model.PolicyTypeID" asp-page-handler="Next" class="btn btn-info fixed-width-btn float-end">Next>></button>
        </div>
    </div> 
</form>
@if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
{
    <p class="text-danger">@ViewData["ErrorMessage"]</p>
}
@section scripts {
    <script>
        function closeModal(modalName) {
            var modal = document.getElementById(modalName);
            modal.style.display = 'none';
        }
    </script>
    
    <script>
        //script to blur the id textbox, so that the person won't copy during a confirm
        function hideInputContent(input) {
            // Add a CSS class to visually hide the content
            input.classList.add('hidden');
        }

        function showInputContent(input) {
            // Remove the CSS class to show the content
            input.classList.remove('hidden');
        }
    </script>
    <script>
        function openCoverModal(id) {
            // Set the ID in the hidden field
            document.getElementById('policyBeneficiaryid').value = id;
            // Open the modal
            $('#premiumsModal').modal('show');
        }
    </script>

    <script>
        document.addEventListener('input', function (e) {
            if (e.target.classList.contains('premium-input')) {
                updatePremiumTotal();
            }
            else if (e.target.classList.contains('cover-input')) {
                updateCoverTotal();
            }
        });

        function updatePremiumTotal() {
            var totalPremium = 0;
            var premiumInputs = document.querySelectorAll('.premium-input');
            premiumInputs.forEach(function (input) {
                totalPremium += parseFloat(input.value) || 0;
            });

            document.getElementById('totalPremiumAmount').textContent = totalPremium.toFixed(2);
        }
        function updateCoverTotal() {
            var totalCover = 0;
            var coverInputs = document.querySelectorAll('.cover-input');
            coverInputs.forEach(function (input) {
                totalCover += parseFloat(input.value) || 0;
            });

            document.getElementById('totalCoverAmount').textContent = totalCover.toFixed(2);
        }
        // Initial update on page load
        document.addEventListener('DOMContentLoaded', updatePremiumTotal);
        document.addEventListener('DOMContentLoaded', updateCoverTotal);
    </script>
    <script>
        function scrollToBottom() {
            // Scroll to the bottom of the page
            window.scrollTo(0, document.body.scrollHeight);
        }

        // Attach the scrollToBottom function to the window's load event
        window.onload = scrollToBottom;
    </script>
    <script>
        function preventPaste(event) {
            event.preventDefault();
            alert("Pasting of IDs is not allowed!");
            return false;
        }
    </script>
    <script>
        function toggleTextBox() {
            var dropdown = document.getElementById('PolicyBeneficiaryLine_ProductID');
            var div = document.getElementById('coverDiv');

            // Check the selected value of the dropdown 
            var selectedText = dropdown.options[dropdown.selectedIndex].text;           

            // Show or hide the div based on the selected value
            if (selectedText.includes("(Investment Product)")) {
                div.style.display = 'none';  // Show
                // var coverLbl = document.getElementById('coverLbl');
                // // Update the label text based on whether product includes (Investment)
                // coverLbl.textContent = 'Sum Assured (optional)';
            } 
            else {
                div.style.display = 'block';   // Hide
            }            
        }
    </script>
