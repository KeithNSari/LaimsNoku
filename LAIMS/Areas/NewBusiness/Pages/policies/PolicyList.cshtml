@{
    Layout = "/Pages/Shared/_LayoutPolicyTypes.cshtml";
}
@using System.Data;
@model LAIMS.Areas.NewBusiness.Pages.policies.PolicyListModel
@{
}
<h1>Policies</h1>
<h5>Select your target policy below.</h5>
<hr />
<table class="table table-hover">
    <tr>
        <th>Name</th>
        <th>Open</th>
        <th>Currency</th>
        <th>Added On</th>
        <th>Added By</th>
        <th></th>
    </tr>
    @if (Model.PolicyTypesDT != null)
    {
        foreach (DataRow DR in Model.PolicyTypesDT.Rows)
        {
            <tr>
                <td>@DR["Name"]</td>
                <td>@DR["OpenForNewBusiness"]</td>
                <td>@DR["Currency"]</td>
                <td>@DR["AddedOn"]</td> 
                <td class="text-end"> 
                    <a asp-page="Details" asp-route-id="@DR["ID"]" class="btn btn-info btn-sm">Submit</a> 
                </td>
            </tr>
        }
    }
</table>
