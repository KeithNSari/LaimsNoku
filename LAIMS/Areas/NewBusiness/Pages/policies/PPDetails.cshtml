<div class="row mb-3">
    <form method="post">
        <button type="Next" asp-route-policyid="@Model.PolicyID" asp-route-id="@Model.ProposerID" asp-route-policytypeid="@Model.PolicyTypeID" asp-page-handler="Next" class="btn btn-info fixed-width-btn float-end">Next>></button>
    </form>
</div>