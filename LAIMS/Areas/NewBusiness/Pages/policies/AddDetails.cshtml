            <label asp-for="PolicyDates.PreferredBillingDay"><b>@Html.DisplayNameFor(m => m.PolicyDates.PreferredBillingDay)</b></label>      
            <input asp-for="PolicyDates.PreferredBillingDay" class="form-control" />
            <span asp-validation-for="PolicyDates.PreferredBillingDay" class="text-danger"></span>
          </div>
        }                  
        <div class="col-sm-3">
            <label asp-for="PolicyDates.DeductionStartDate"><b>@Html.DisplayNameFor(m => m.PolicyDates.DeductionStartDate)</b></label>
            <input type="date" asp-for="PolicyDates.DeductionStartDate" class="form-control" />
            <span asp-validation-for="PolicyDates.DeductionStartDate" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
        </div>
        <div class="col-md-2">
        </div>
        <div class="col-md-8">
            <button type="Next" asp-route-policyid="@Model.PolicyID" asp-route-id="@Model.MemberID" asp-route-policytypeid="@Model.PolicyTypeID" asp-page-handler="Next" class="btn btn-info fixed-width-btn float-end">Next>></button>
        </div>
    </div>
</form>
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="@Model.PolicyPremiumID" />
    <div class="modal fade" id="investmentModal" tabindex="-1" aria-labelledby="investmentModal" aria-hidden="true">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title" id="investmentModal">Add Investment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h2></h2>
                    @if (TempData["PostbackSuccess"] != null && (bool)TempData["PostbackSuccess"])
                    {
                        <script>
                            closeModal('investmentModal');
                        </script>
                    }
                    <div class="row mb-3">
                        <div class="form-group">
                            <label asp-for="PolicyBeneficiaryLine.ProductID" class="control-label" id="productLbl"><b>Product</b></label>
                            <select asp-for="PolicyBeneficiaryLine.ProductID" required class="form-control" asp-items="Model.MyInvestmentProducts">
                            </select>
                            <span asp-validation-for="PolicyBeneficiaryLine.ProductID" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PolicyBeneficiaryLine.Contribution"><b>Premium</b></label>
                                <input asp-for="PolicyBeneficiaryLine.Contribution" class="form-control" step="0.01" />
                                <span asp-validation-for="PolicyBeneficiaryLine.Contribution" class="text-danger"></span>
                            </div>
                        </div>
                    </div> 
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <input type="submit" value="Save Changes" asp-page="AddDetails" asp-route-policyid="@Model.PolicyID" asp-route-id="@Model.MemberID" asp-route-policytypeid="@Model.PolicyTypeID" asp-page-handler="AddInvestment" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </div>
</form>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#PolicyTerm').on('input', function () {
                var newValue = $(this).val();
                var id = $(this).data('id');
                $.ajax({
                    type: 'GET',
                    url: '?handler=AddPolicyTerm',
                    data: { policyid: id, policyTerm: newValue },
                    success: function (response) {
                        console.log('Value updated successfully');
                    },
                    error: function (error) {
                        console.log('Error updating value');
                    }
                });
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('.cover-input').on('input', function () {
                var coverInput = $(this);
                var productId = coverInput.data('product-id');
                var cover = parseFloat($(this).val()); 
                if (!isNaN(cover)) { 
                    var policyBeneficiaryid = $('#policyBeneficiaryid').val();
                    var tested = $('#Tested').val();
                    var smoker = $('#Smoker').val();
                    $.ajax({
                        type: 'GET',
                        url: '?handler=FetchPremium',
                        data: {
                            productId: productId,
                            policyBeneficiaryid: policyBeneficiaryid,
                            cover: cover,
                            tested: tested,
                            smoker: smoker
                        },
                        success: function (premium) {
                            console.log(premium);
                            coverInput.closest('tr').find('.premium').text(premium);
                        },
                        error: function (error) {
                            console.log('Error fetching value');
                        }
                    });
                }
            });
        });
    </script>
    <script>
        function openCoverModal(id) {
            // Set the ID in the hidden field
            document.getElementById('policyBeneficiaryid').value = id;
            // Open the modal
            $('#premiumsModal').modal('show');
        }
    </script>
   <script>
    document.addEventListener('DOMContentLoaded', function() {
        const dropdown = document.getElementById('Smoker');
        const textboxes = document.querySelectorAll('.cover-input');
        const spans = document.querySelectorAll('.premium');

        dropdown.addEventListener('change', function() {
            textboxes.forEach(function(textbox) {
                textbox.value = '0';
            });
            spans.forEach(function(span) {
                span.textContent = '0';
            });
        });
    });
   </script> 
   <script>
    document.addEventListener('DOMContentLoaded', function() {
        const dropdown = document.getElementById('Tested');
        const textboxes = document.querySelectorAll('.cover-input');
        const spans = document.querySelectorAll('.premium');

        dropdown.addEventListener('change', function() {
            textboxes.forEach(function(textbox) {
                textbox.value = '0';
            });
            spans.forEach(function(span) {
                span.textContent = '0';
            });
        });
    });
   </script>
    <script>
        function preventPaste(event) {
            event.preventDefault();
            alert("Pasting of IDs is not allowed!");
            return false;
        }
    </script>
}
