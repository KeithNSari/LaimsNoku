@page
@using System.Data;
@model LAIMS.Areas.NewBusiness.Pages.policies.AddDetailsModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h1>Application: Add Details</h1>
<div class="bg-light">
    <hr />
    <h3>Policy: @Model.PolicyName</h3>
    <div class="nav-wizards-container">
        <nav class="nav nav-wizards-1 mb-2">
            <div class="nav-item col">
                <a class="nav-link completed" asp-page="SelectPolicy" asp-route-id="@Model.MemberID">
                    <div class="nav-no">1</div>
                    <div class="nav-text">Select Policy</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link active" asp-page="NewApplication" asp-route-id="@Model.MemberID" asp-route-policyid="@Model.PolicyID" asp-route-policyTypeId="@Model.PolicyTypeID">
                    <div class="nav-no">2</div>
                    <div class="nav-text">Add Details</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link disabled" href="#">
                    <div class="nav-no">3</div>
                    <div class="nav-text">Split</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link disabled" href="#">
                    <div class="nav-no">4</div>
                    <div class="nav-text">Documents</div>
                </a>
            </div>
            <div class="nav-item col">
                <a class="nav-link disabled" href="#">
                    <div class="nav-no">5</div>
                    <div class="nav-text">Questionnaires</div>
                </a>
            </div> 
            <div class="nav-item col">
                <a class="nav-link disabled" href="#">
                    <div class="nav-no">6</div>
                    <div class="nav-text">Submission</div>
                </a>
            </div>
        </nav>
    </div>
    <hr />
</div>
<table class="table table-hover">
    <tr>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
        <th class="col-md-2"></th>
    </tr>
    <tr>
        <td><b>First Name:</b></td>
        <td>@Model.Member.Name1</td>
        <td><b>Middle Name:</b></td>
        <td>@Model.Member.Name2</td>
        <td><b>Surname:</b></td>
        <td>@Model.Member.Name3</td>
    </tr>
    <tr>
        <td><b>Gender:</b></td>
        <td>@Model.Member.Gender</td>
        <td><b>Title:</b></td>
        <td>@Model.Member.Title</td>
        <td><b>Marital Status:</b></td>
        <td>@Model.Member.MaritalStatus</td>
    </tr>
    <tr>
        <td><b>D.O.B:</b></td>
        <td>@Model.Member.DOB.Value.ToString("yyyy-MMM-dd")</td>
        <td><b>Birth Country:</b></td>
        <td>@Model.Member.BirthCountry</td>
        <td><b>Place Of Birth:</b></td>
        <td>@Model.Member.PlaceOfBirth</td>
    </tr>
    <tr>
        <td><b>Citizenship:</b></td>
        <td>@Model.Member.Country</td>
        <td><b>Member No:</b></td>
        <td>@Model.Member.MemberNo</td>
        <td><b>National ID:</b></td>
        <td>@Model.Member.NationalID</td>
    </tr>
    <tr>
        <td><b>Passport:</b></td>
        <td>@Model.Member.Passport</td>
        <td><b>Birth Certificate:</b></td>
        <td>@Model.Member.BirthCertificate</td>
        <td></td>
        <td></td>
    </tr>
</table> 
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="@Model.PolicyPremiumID" />
    <div class="modal fade" id="rolesModal" tabindex="-1" aria-labelledby="rolesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="rolesModalLabel">Add Roles</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h2></h2>
                    @if (TempData["PostbackSuccess"] != null && (bool)TempData["PostbackSuccess"])
                    {
                        <script>
                            closeModal('rolesModal');
                        </script>
                    }
                    <div class="row mb-3">
                        <div class="form-group">
                            <label>
                             <input type="checkbox" asp-for="@Model.ProposerDetails.IsMainLifeAssured" class="large-checkbox"/>
                             <b>Is Main Life Assured</b>
                           </label>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="form-group">
                           <label>
                             <input type="checkbox" asp-for="@Model.ProposerDetails.IsBeneficiary" class="large-checkbox" />
                             <b>Is Beneficiary</b>
                           </label>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="form-group">
                          <label>
                            <input type="checkbox" asp-for="@Model.ProposerDetails.IsPremiumPayer" class="large-checkbox" />
                            <b>Proposer Is Premium Payer</b>
                          </label>
                        </div>
                    </div>                   
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <input type="submit" value="Save Changes" asp-page="AddDetails" asp-route-policyid="@Model.PolicyID" asp-route-id="@Model.MemberID" asp-route-policytypeid="@Model.PolicyTypeID" asp-page-handler="AddProposerRoles" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </div>
</form>
<div class="d-flex justify-content-end align-items-center">
    @if (Model.MinimumTerm > 0)
    {
        <div class="me-2 d-flex align-items-center">
            <label class="me-2"><b>Policy Term:</b></label>
            <input type="number" asp-for="@Model.PolicyTerm" data-id="@Model.PolicyID" min="1" max="999" class="form-control" style="width: 80px;" />
        </div>
    }
    <button type="button" class="btn btn-success mx-2" data-bs-toggle="modal" data-bs-target="#rolesModal">
        Add Proposer Roles
    </button>
    @if (Model.IsPureInvestmentProduct)
    {
        <button type="button" class="btn btn-primary mx-2" data-bs-toggle="modal" data-bs-target="#investmentModal">
            Add Investment
        </button>
    }
</div>
<hr/> 
<h3>Payment Collection Details</h3>
<hr/>
<div class="d-flex justify-content-end">
    <button type="button" class="btn btn-primary float-end mx-2 fixed-width-btn" data-bs-toggle="modal" data-bs-target="#premiumPayerModal">
        Add Premium Payer
    </button>
    <button type="button" class="btn btn-success float-end mx-2 fixed-width-btn" data-bs-toggle="modal" data-bs-target="#stopOrderModal">
        Add Stop Order
    </button>
    <button type="button" class="btn btn-info float-end mx-2 fixed-width-btn" data-bs-toggle="modal" data-bs-target="#debitOrderModal">
        Add Debit Order
    </button>
    <button type="button" class="btn btn-secondary float-end mx-2 fixed-width-btn" data-bs-toggle="modal" data-bs-target="#directPaymentModal">
        Add Direct Payment
    </button>
</div>
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="@Model.PolicyPremiumID" />
    <div class="modal fade" id="stopOrderModal" tabindex="-1" aria-labelledby="stopOrderModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title" id="stopOrderModalLabel">Add Stop Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h2></h2>
                    @if (TempData["PostbackSuccess"] != null && (bool)TempData["PostbackSuccess"])
                    {
                        <script>
                            closeModal('stopOrder');
                        </script>
                    }
                    <div class="row mb-3">
                        <div class="form-group">
                            <label asp-for="PolicyPremium.PaymentProviderID" class="control-label"><b>Stop Order Provider</b></label>
                            <select asp-for="PolicyPremium.PaymentProviderID" asp-items="Model.StopOrderProviderList" class="form-control" aria-required="true">
                                <option value="">Select Option</option>
                            </select>
                            <span asp-validation-for="PolicyPremium.PaymentProviderID" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="PolicyPremium.PaymentFrequencyID" class="control-label"><b>Frequency</b></label>
                                <select asp-for="PolicyPremium.PaymentFrequencyID" required class="form-control" aria-required="true">
                                    <option value="">Select Option</option>
                                    <option value=1>Monthly</option>
                                    <option value=2>Quarterly</option>
                                    <option value=3>Half Yearly</option>
                                    <option value=4>Annually</option>
                                    <option value=5>Single Injections</option>
                                </select>
                                <span asp-validation-for="PolicyPremium.PaymentFrequencyID" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="@Model.Employment.EmploymentNo"><b>Employment No</b></label>
                                <input asp-for="@Model.Employment.EmploymentNo" required class="form-control" autocomplete="off" />
                                <span asp-validation-for="@Model.Employment.EmploymentNo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="@Model.Employment.CategoryID"><b>Category</b></label>
                                <select asp-for="@Model.Employment.CategoryID" class="form-control" required asp-items="Model.CategoriesList">
                                    <option value="">Select Category</option>
                                </select>
                                <span asp-validation-for="@Model.Employment.CategoryID" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="@Model.Employment.JobTitle"><b>Job Title</b></label>
                                <input asp-for="@Model.Employment.JobTitle" required class="form-control" autocomplete="off" />
                                <span asp-validation-for="@Model.Employment.JobTitle" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <input type="submit" value="Save Changes" asp-route-policyid="@Model.PolicyID" asp-route-id="@Model.MemberID" asp-route-policytypeid="@Model.PolicyTypeID" asp-page-handler="AddStopOrder" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </div>
</form>
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="@Model.PolicyPremiumID" />
    <div class="modal fade" id="debitOrderModal" tabindex="-1" aria-labelledby="debitOrderModalLabel" aria-hidden="true">
