@page
@using System.Data
@model LAIMS.Areas.NewBusiness.Pages.policies.PendingIndexModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutSearch.cshtml";
}
<h1>Job Queue</h1>
<hr />
@if (Model.SearchTerm != null)
{
    @if ((Model.PoliciesDT != null) && (Model.PoliciesDT.Rows.Count > 0))
    {
        <div class="row mb-3">
            <h5>@Model.ResultsCount results found for search "@Model.SearchTerm"!</h5>
        </div>
    }
    <hr />
} 
<div class="row mb-3">
    <form method="post">
        <table class="table table-hover">
            <tr>
                <th>Entry </th>
                <th>Applied</th>
                <th>Application No</th> 
                <th>Policy</th>
                <th>Stage</th>
                <th>Created</th>
                <th></th>
            </tr>
            @if (Model.PoliciesDT != null)
            {
                @foreach (DataRow DR in Model.PoliciesDT.Rows)
                {
                    <tr>
                        <td>@DR["EntryNo"]</td>
                        <td>@DR["ApplicationDate"]</td>
                        <td>@DR["ApplicationNo"]</td> 
                        <td>@DR["PolicyTypeName"]</td>
                        <td>@DR["Stage"]</td>
                        <td>@DR["AddedOn"]</td>
                        <td class="text-end">
                            <button type="submit" asp-route-memberId="@DR["UID"]" asp-route-policyTypeId="@DR["PolicyType"]" asp-route-policyId="@DR["ID"]" asp-page-handler="PolicyDetails" class="btn btn-info btn-sm">View</button> 
                        </td>
                    </tr>
                }
            }
        </table>
    </form>
</div>