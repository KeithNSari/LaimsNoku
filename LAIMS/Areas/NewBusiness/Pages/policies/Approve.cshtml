@page
@using System.Data
@model LAIMS.Areas.NewBusiness.Pages.policies.ApproveModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutSearch.cshtml";
}
<h1>Applications Awaiting Approval</h1> 
<hr/>
@if (Model.SearchTerm != null)
{
    @if ((Model.PoliciesDT != null) && (Model.PoliciesDT.Rows.Count > 0))
    {
        <div class="row mb-3">
            <h5>@Model.ResultsCount policies awaiting approval, found for search "@Model.SearchTerm"!</h5>
        </div>
    }
    <hr />
}
else
{
    @if (Model.PoliciesDT != null)
    {
        <div class="row mb-3">
            <h5>Showing @Model.ResultsCount applications of @Model.TotalCount!</h5>
        </div>
    }
    <hr />
}
<div class="row mb-3">
    <form method="post">
        <table class="table table-hover">
            <tr>
                <th>Entry </th>
                <th>Applied</th>
                <th>Application No</th>               
                <th>Policy</th>
                <th>Stage</th>
                <th>Status Date</th>
                <th></th>
            </tr>
            @if (Model.PoliciesDT != null)
            {
                @foreach (DataRow DR in Model.PoliciesDT.Rows)
                {
                    <tr>
                        <td>@DR["EntryNo"]</td>
                        <td>@DR["ApplicationDate"]</td>
                        <td>@DR["ApplicationNo"]</td>                       
                        <td>@DR["PolicyTypeName"]</td>
                        <td>@DR["Status"]</td>
                        <td>@DR["PolicyStatusDate"]</td>
                        <td class="text-end">
                            <a asp-route-id="@DR["UID"]" asp-route-policyTypeid="@DR["PolicyType"]" asp-route-policyid="@DR["ID"]" asp-page="Reviews" class="btn btn-info btn-sm">Review</a>
                        </td>
                    </tr>
                }
            }
        </table>
    </form>
</div>