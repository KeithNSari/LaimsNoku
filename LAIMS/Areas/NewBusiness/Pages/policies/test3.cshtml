@page
@model LAIMS.Areas.NewBusiness.Pages.policies.test3Model
@{
}
@{
    Layout = "/Pages/Shared/_LayoutNewBusiness.cshtml";
}
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#myModal">
    Open Modal
</button>

<!-- Your modal -->
<div class="modal fade" id="myModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Modal Title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Display the table in the modal form -->
                <table class="table">
                    <thead>
                        <!-- Assuming column names are known -->
                        <tr>
                            <th>Column 1</th>
                            <th>Column 2</th>
                            <!-- Add more header columns as needed -->
                        </tr>
                    </thead>
                    <tbody id="modalTableBody">
                        <!-- Table rows will be dynamically added here -->
                    </tbody>
                </table>

                <!-- ... (unchanged form and button) -->
            </div>
        </div>
    </div>
</div>

<!-- Your JavaScript to handle modal and AJAX -->
@section Scripts {
    <script>
        $(document).ready(function () {
            // Function to open the modal and fetch data
            function openModalAndFetchData() {
                $.ajax({
                    url: 'test3?handler=LoadData', // The handler method
                    type: 'GET',
                    success: function (data) {
                        console.log(data); // Log the received data
                        // Clear existing content in the table body
                        $('#modalTableBody').empty();

                        // Display the fetched data in the modal
                        data.forEach(function (row) {
                            var newRow = '<tr><td>' + row.column1 + '</td><td>' + row.column2 + '</td></tr>';
                            $('#modalTableBody').append(newRow);
                        });

                        // Show the modal
                        $('#myModal').modal('show');
                    },
                    error: function () {
                        // Handle error
                        alert('Failed to fetch data from the server.');
                    }
                });
            }

            // Attach the function to the button click event
            $('#myModal').on('show.bs.modal', openModalAndFetchData);
        });
    </script>
}