@page
@using System.Data;
@{
    Layout = "/Pages/Shared/_LayoutPolicyTypes.cshtml";
}
@model LAIMS.Areas.NewBusiness.Pages.Membership.MContactsModel
@{
}
<h1>Contact Details</h1>
<hr />
<div>
    <div class="bg-light">
        <h4> </h4>
    </div>
    <div class="row"> 
        <form method="post">
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MemberContact.ContactTypeID" class="control-label"><b>Contact Type</b></label>
                        <select asp-for="MemberContact.ContactTypeID" asp-items="@(new SelectList(Model.ContactTypes, "ID", "Type"))" class="form-control"></select>
                        <span asp-validation-for="MemberContact.ContactTypeID" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MemberContact.Line1" class="control-label"><b>Address Line 1</b></label>
                        <input asp-for="MemberContact.Line1" class="form-control" />
                        <span asp-validation-for="MemberContact.Line1" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MemberContact.Line2" class="control-label"><b>Address Line 2</b></label>
                        <input asp-for="MemberContact.Line2" class="form-control" />
                        <span asp-validation-for="MemberContact.Line2" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MemberContact.Line3" class="control-label"><b>Address Line 3</b></label>
                        <input asp-for="MemberContact.Line3" class="form-control" />
                        <span asp-validation-for="MemberContact.Line3" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CountryID" class="control-label"><b>Country</b></label>
                        <select asp-for="CountryID" asp-items="@(new SelectList(Model.Countries, "CountryID", "CountryName"))" class="form-control" id="countryDropdown">
                            <option value="">Select Country</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="CityID" class="control-label"><b>City</b></label>
                        <select asp-for="CityID" id="cityDropdown" class="form-control"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="CustomCity" class="control-label"><b>Or Enter City</b></label>
                        <input asp-for="CustomCity" class="form-control" />
                    </div> 
                    <div class="form-group">
                        <label asp-for="MemberContact.Preferred" class="control-label"><b>Preferred</b></label>
                        <select asp-for="MemberContact.Preferred" class="form-control" aria-required="true">
                            <option value="">Select Option</option>
                            <option value=0>No</option>
                            <option value=1>Yes</option>
                        </select>
                        <span asp-validation-for="MemberContact.Preferred" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <hr />
                <button type="submit" class="btn btn-primary">Create</button>
            </div>           
        </form>
    </div>
    <div class="row">
         <form method="post">
            <table class="table table-hover">
                <tr>
                    <th>Type</th>
                    <th>Line 1</th>
                    <th>Line 2</th>
                    <th>Line 3</th>
                    <th>City</th>
                    <th>Country</th>
                    <th></th>
                </tr>
                @if (Model.ContactsDT != null)
                {
                    @foreach (DataRow DR in Model.ContactsDT.Rows)
                    {
                        <tr>
                            <td>@DR["ContactType"]</td>
                            <td>@DR["Line1"]</td>
                            <td>@DR["Line2"]</td>
                            <td>@DR["Line3"]</td>
                            <td>@DR["City"]</td>
                            <td>@DR["Country"]</td>
                            <td class="text-end">
                                <a asp-page="EditContacts" asp-route-MemberUID="@DR["MemberUID"]" asp-route-ContactID="@DR["ID"]" class="btn btn-outline-primary btn-sm">Edit</a>
                                <button type="submit" asp-route-MemberUID="@DR["MemberUID"]" asp-route-ContactID="@DR["ID"]" asp-page-handler="Archive" class="btn btn-danger" onclick="return confirm('Are you sure you want to Archive this item?');">Archive</button>
                            </td>
                        </tr>
                    }
                }
            </table>
         </form>        
    </div>
</div>
@section scripts{
    <script>
        $(function () {
            $("#countryDropdown").on("change", function () {
                var countryId = $(this).val();
                $("#cityDropdown").empty();
                $("#cityDropdown").append("<option value='0'>Select City</option>");
                $.getJSON(`?handler=CitiesByCountry&countryid=${countryId}`, (data) => {
                    $.each(data, function (i, city) {
                        $("#cityDropdown").append(`<option value="${city.id}">${city.cityName}</option>`);
                    });
                });
            });
        });
    </script>
}