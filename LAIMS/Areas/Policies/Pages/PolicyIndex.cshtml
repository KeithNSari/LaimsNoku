@page
@using System.Data 
@model LAIMS.Areas.Policies.Pages.PolicyIndexModel
@{
    Layout = "/Pages/Shared/_LayoutSearch.cshtml";
}
<h1>Policies</h1>
<hr />
@if ((Model.PoliciesDT != null) && (Model.PoliciesDT.Rows.Count > 0))
{
    <div class="row mb-3">
        @if(Model.PoliciesDT.Rows.Count == 1)
        {
            <h5>@Model.ResultsCount entry!</h5>
        }
        else
        {
            <h5>@Model.ResultsCount entries!</h5>
        }        
    </div>
}
<hr />
<div class="row mb-3">
    <form method="post">
        <table class="table table-hover">
            <tr>
                <th>Entry </th>
                <th>Commencement</th>
                <th>Policy Holder</th>
                <th>Policy No</th>
                <th>Policy</th>
                <th>Status</th>
                <th>Status Date</th>
                <th></th>
            </tr>
            @if (Model.PoliciesDT != null)
            {
                @foreach (DataRow DR in Model.PoliciesDT.Rows)
                {
                    <tr>
                        <td>@DR["EntryNo"]</td>
                        <td>@DR["CommencementDate"]</td>
                        <td>@DR["PolicyHolder"]</td>
                        <td>@DR["PolicyNo"]</td>
                        <td>@DR["PolicyTypeName"]</td>
                        <td>@DR["Status"]</td>
                        <td>@DR["PolicyStatusDate"]</td>
                        <td class="text-end">
                            <a asp-route-id="@DR["UID"]" asp-route-policyTypeid="@DR["PolicyType"]" asp-route-policyid="@DR["ID"]" asp-page="Details" class="btn btn-info btn-sm">Details</a>
                        </td>
                    </tr>
                }
            }
        </table>
    </form>
</div>