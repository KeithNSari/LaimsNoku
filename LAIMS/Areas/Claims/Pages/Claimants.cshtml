                                    <span asp-validation-for="@Model.PayAfter" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label asp-for="@Model.Amount"><b>Amount</b></label>
                                    <input asp-for="@Model.Amount" required class="form-control" autocomplete="off" />
                                    <small class="text-muted">Amount to be paid out.</small>
                                    <span asp-validation-for="@Model.Amount" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12 text-end">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                <input type="submit" value="Save Changes" asp-page-handler="AddServiceProvider" class="btn btn-primary" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 
