@section scripts 
{
    <script>
        $(document).ready(function () {
            $('#qsnModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var url = button.data('url');
                $('#modalIframe').attr('src', url);
            });

        });
    </script>
    <script>
        function closeModal(modalName) {
            var modal = document.getElementById(modalName);
            modal.style.display = 'none';
        }
    </script>
    <script>
        $(document).ready(function () {
            $('#pdfModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var url = button.data('url');
                openPdfModal(url);
            });
        });
        function openPdfModal(pdfSource) {
            // Make a Fetch API request to fetch PDF data from the server
            fetch(pdfSource, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/pdf', // Adjust the content type as needed
                },
                responseType: 'blob', // Specify that you want the response as a Blob
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.blob(); // Get the response as a Blob
                })
                .then(blobData => {
                    try {
                        console.log('Blob created:', blobData);

                        // Create a data URL from the Blob
                        var pdfUrl = URL.createObjectURL(blobData);
                        console.log('PDF URL created:', pdfUrl);

                        // Update the iframe source with the PDF data URL
                        $('#pdfIframe').attr('src', pdfUrl);
                        console.log('IFrame src:', pdfUrl);

                        // Show the modal
                        $('#pdfModal').modal('show');
                    } catch (error) {
                        console.error('Error processing PDF data:', error);
                    }
                })
                .catch(error => {
                    console.error('Fetch error:', error);
                });
        }
    </script>
    <script>
        document.addEventListener('input', function (e) {
            if (e.target.classList.contains('premium-input')) {
                updatePremiumTotal();
            }
            else if (e.target.classList.contains('cover-input')) {
                updateCoverTotal();
            }
        });

        function updatePremiumTotal() {
            var totalPremium = 0;
            var premiumInputs = document.querySelectorAll('.premium-input');
            premiumInputs.forEach(function (input) {
                totalPremium += parseFloat(input.value) || 0;
            });

            document.getElementById('totalPremiumAmount').textContent = totalPremium.toFixed(2);
        }
        function updateCoverTotal() {
            var totalCover = 0;
            var coverInputs = document.querySelectorAll('.cover-input');
            coverInputs.forEach(function (input) {
                totalCover += parseFloat(input.value) || 0;
            });

            document.getElementById('totalCoverAmount').textContent = totalCover.toFixed(2);
        }
        // Initial update on page load
        document.addEventListener('DOMContentLoaded', updatePremiumTotal);
        document.addEventListener('DOMContentLoaded', updateCoverTotal);
    </script>
}