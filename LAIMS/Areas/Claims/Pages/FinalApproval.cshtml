@page
@using System.Data
@model LAIMS.Areas.Claims.Pages.FinalApprovalModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h2>Claim Approval</h2>
<p>Instruction: Review claim and scroll to the bottom to add your decision!</p>
<hr />
<div class="row mb-3">
    <div class="container">
        @foreach (var record in Model.DeathRecords)
        {
            <h3>Death Records for @record.MemberName</h3>
            <hr />
            <div class="row">
                <div class="col-md-3">
                    <strong>Date Health Affected:</strong> @record.DateHealthAffected
                </div>
                <div class="col-md-3">
                    <strong>Date Of Death:</strong> @record.DateOfDeath.ToString("yyyy-MM-dd")
                </div>
                <div class="col-md-3">
                    <strong>Event Cause:</strong> @record.EventCauseName
                </div>
                <div class="col-md-3">
                    <strong>Cause Details:</strong> @record.CauseDetails
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-3">
                    <strong>Place:</strong> @record.Place
                </div>
                <div class="col-md-3">
                    <strong>Hospital:</strong> @record.Hospital
                </div>
                <div class="col-md-3">
                    <strong>Police Station:</strong> @record.PoliceStation
                </div>
                <div class="col-md-3">
                    <strong>Case Reference No:</strong> @record.CaseReferenceNo
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-3">
                    <strong>Burial Order No:</strong> @record.BurialOrderNo
                </div>
                <div class="col-md-3">
                    <strong>Death Certificate No:</strong> @record.DeathCertificateNo
                </div>
                <div class="col-md-3">
                    <strong>Added By:</strong> @record.AddedBy
                </div>
                <div class="col-md-3">
                    <strong>Added On:</strong> @record.AddedOn.ToString("yyyy-MM-dd HH:mm:ss")
                </div>
            </div>
            <hr />
        }
    </div>
</div>
<h3>Cover Details</h3>
<div class="row mb-3">
    <div class="row mb-3">
        <table class="table table-striped">
            <tr>
                <th class="col-md-4">Product</th>
                <th class="col-md-2">Type</th>
                <th class="col-md-2">Premium</th>
                <th class="col-md-2">Cover</th>
                <th class="col-md-2">Balance</th>
            </tr>
            @if (Model.CoverDT != null)
            {
                @foreach (DataRow DR in Model.CoverDT.Rows)
                {
                    <tr>
                        <td>@DR["Product"]</td>
                        <td>@DR["CoverType"]</td>
                        <td>@DR["Premium"]</td>
                        <td>@DR["Cover"]</td>
                        <td>@DR["Balance"]</td>
                    </tr>
                }
            }
        </table>
    </div>
</div>
<h2>Claimant List</h2>
<hr />
<h5>Basic Cover Split Values</h5>
<table class="table table-striped">
    <tr>
        <th>Member</th>
        <th>Role</th>
        <th>Bank</th>
        <th>Account No</th>
        <th>Allocated</th>
    </tr>

    @foreach (DataRow DR in Model.BasicCoverClaimantsDT.Rows)
    {
        <tr>
            <td>@DR["MemberName"]</td>
            <td>@DR["RoleName"]</td>
            <td>@DR["Bank"]</td>
            <td>@DR["BankAccountNo"]</td>
            <td>@DR["Amount"]</td>
        </tr>
    }
</table>
<h5>Supplementary Cover Split Values</h5>
<table class="table table-striped">
    <tr>
        <th>Member</th>
        <th>Product</th>
        <th>Bank</th>
        <th>Account No</th>
        <th>Pay After</th>
        <th>Allocated</th>
    </tr>
    @foreach (DataRow DR in Model.SupplementaryCoverClaimantsDT.Rows)
    {
        <tr>
            <td>@DR["MemberName"]</td>
            <td>@DR["Product"]</td>
            <td>@DR["Bank"]</td>
            <td>@DR["BankAccountNo"]</td>
            <td>@DR["PayAfter"]</td>
            <td>@DR["Amount"]</td>
        </tr>
    }
</table>
<h2>Uploaded Documents</h2>
<hr />
<div class="row">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Document Name</th>
                <th>Filing No</th>
                <th> Added</th>
                <th>Upload</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.FileUploadModelList.Count; i++)
            {
                <tr>
                    <td>@Model.FileUploadModelList[i].DocumentName</td>
                    <td>@Model.FileUploadModelList[i].FilingNo</td>
                    <td>@Model.FileUploadModelList[i].AddedOn</td>
                    <td>
                        @if (Model.FileUploadModelList[i].Uploaded)
                        {
                            <button type="button" data-bs-toggle="modal" data-bs-target="#pdfModal" data-url="SubmitClaim?handler=DownloadPdfFromDatabase&docId=@Model.FileUploadModelList[i].MediaUploadID" class="btn btn-success">View</button>
                        }
                        else
                        {
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<!-- Modal -->
<div class="modal fade" id="pdfModal" tabindex="-1" role="dialog" aria-labelledby="pdfModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pdfModalLabel">PDF Viewer</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Add an iframe for displaying the PDF -->
                <iframe id="pdfIframe" width="100%" height="400px" frameborder="0"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<h3>Service Breakdown</h3>
<div class="row mb-3">
    <table class="table table-striped">
        <tr>
            <th class="col-md-6">Service</th>
            <th class="col-md-3">Allocated</th>
        </tr>
        @if (Model.ServiceBreakdownDT != null)
        {
            @foreach (DataRow DR in Model.ServiceBreakdownDT.Rows)
            {
                <tr>
                    <td>@DR["Service"]</td>
                    <td>@DR["Amount"]</td>
                </tr>
            }
        }
    </table>
</div>
<div class="row mb-3">
    @if (Model.ExpensesDT != null)
    {
        <h3>Policy Claim Expenses</h3>
        <hr />
        <table class="table table-hover">
            <tr>
                <th>Entry</th>
                <th>Expense</th>
                <th>Currency</th>
                <th>Amount</th>
            </tr>
            @foreach (DataRow DR in Model.ExpensesDT.Rows)
            {
                <tr>
                    <td>@DR["ID"]</td>
                    <td>@DR["Expense"]</td>
                    <td class="text-right">@DR["Currency"]</td>
                    <td class="text-right">@DR["Amount"]</td>
                </tr>
            }
            <tr>
                <td></td>
                <td></td>
                <td class="text-right"><strong>Total:</strong></td>
                <td class="text-right">@Model.ExpensesTotal.ToString("F2")</td>
            </tr>
        </table>
    }
</div>
<div class="row mb-3">
    @if (Model.UnpaidDT != null)
    {
        <h3>Unpaid Premiums</h3>
        <hr />
        <table class="table table-hover">
            <tr>
                <th>Due Date</th>
                <th>Invoice No</th>
                <th>Currency</th>
                <th>Amount</th>
            </tr>
            @foreach (DataRow DR in Model.UnpaidDT.Rows)
            {
                <tr>
                    <td>@DR["DueDate"]</td>
                    <td>@DR["InvoiceNo"]</td>
                    <td class="text-right">@DR["Currency"]</td>
                    <td class="text-right">@DR["Amount"]</td>
                </tr>
            }
            <tr>
                <td></td>
                <td></td>
                <td class="text-right"><strong>Total:</strong></td>
                <td class="text-right">@Model.UnpaidTotal.ToString("F2")</td>
            </tr>
        </table>
    }
</div>
<h3>Claim Rule Checks</h3>
<hr />
<div class="row mb-3">
    <table class="table table-hover">
        <tr>
            <th>No</th>
            <th class="col-md-3">Rule</th>
            <th class="col-md-2">Status</th>
            <th class="col-md-2">Comment</th>
            <th class="col-md-2">Date</th>
            <th class="col-md-2">Added By</th>
        </tr>
        @if (Model.StatiiHistoryDT != null)
        {
            @foreach (DataRow DR in Model.StatiiHistoryDT.Rows)
            {
                <tr>
                    <td>@DR["row_number"]</td>
                    <td>@DR["RuleName"]</td>
                    <td>@DR["Status"]</td>
                    <td>@DR["StatusComment"]</td>
                    <td>@DR["StatusDate"]</td>
                    <td>@DR["UserName"]</td>
                </tr>
            }
        }
    </table>
</div>
@if ((Model.SubmittedByDT != null) && (Model.SubmittedByDT.Rows.Count > 0))
{
    <hr />
    <h3>Submitted By</h3>
    <div class="row mb-3">
        <table class="table table-striped">
            <tr>
                <th class="col-md-6">Member Name</th>
                <th class="col-md-3">National ID</th>
                <th class="col-md-3">Added On</th>
            </tr>
            @foreach (DataRow DR in Model.SubmittedByDT.Rows)
            {
                <tr>
                    <td>@DR["MemberName"]</td>
                    <td>@DR["NationalID"]</td>
                    <td>@DR["AddedOn"]</td>
                </tr>
            }
        </table>
    </div>
}
<hr />
<h3> System Decision: @Model.SystemDecision</h3>
<hr />
<h3>Supervisor Decision: Exgratia Requested</h3>
<hr/>
<hr />
<h3>Requested Amount: @Model.DisbursementAmount</h3>
<hr />
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="@Model.PolicyID" />
    <input type="hidden" asp-for="@Model.PolicyTypeID" />
    <input type="hidden" asp-for="@Model.ProposerID" />
    <input type="hidden" asp-for="@Model.RequestID" />
    <div class="row mb-3">
        <div class="col-sm-3">
            <div class="form-group">
                <label asp-for="@Model.StatusID"><b>Decision</b></label>
                <select asp-for="@Model.StatusID" class="form-control" required onchange="toggleExgratia()">
                    <option value="">Select Decision</option>
                    <option value=3150>Request More Information</option>
                    <option value=3200>Claim Rejected</option> 
                    <option value=3350>Claim Approved</option> 
                </select>
                <span asp-validation-for="@Model.StatusID" class="text-danger"></span>
            </div>
        </div>
        <div class="col-sm-9">
            <div class="form-group">
                <label asp-for="@Model.StatusComment"><b>Comment</b></label>
                <textarea asp-for="@Model.StatusComment" class="form-control"></textarea>
                <span asp-validation-for="@Model.StatusComment" class="text-danger"></span>
            </div>
        </div>
    </div>   
    <div class="row mb-3">
        <div class="col-sm-10">
        </div>
        <div class="col-sm-2">
            <button type="submit" class="btn btn-info float-end">Submit</button>
        </div>
    </div>
</form>