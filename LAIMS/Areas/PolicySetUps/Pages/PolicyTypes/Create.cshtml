@page
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
@using System.Data;
@model LAIMS.Areas.PolicySetUps.Pages.PolicyTypes.CreateModel
@{
}
<h1>Policy Definition</h1>
@if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
{
    <p class="text-danger">@ViewData["ErrorMessage"]</p>
}
<h5>Please enter the policy details below.</h5> 
<div class="row">
    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group mb-3">
            <label asp-for="NewPolicyType.Name" class="control-label"><h6>Name</h6></label>
            <input asp-for="NewPolicyType.Name" required class="form-control col-md-12" />
            <span asp-validation-for="NewPolicyType.Name" class="text-danger"></span>
            <div id="nameHelp" class="form-text black-text">Enter the name of the policy.</div>
        </div> 
        <div class="row mb-3">
            <div class="col-sm-3">
                <label asp-for="NewPolicyType.LifeAssuredMinAge" class="control-label"><h6>Life Assured Min Age</h6></label>
                <input asp-for="NewPolicyType.LifeAssuredMinAge" min="0" max="150" required class="form-control" />
                <span asp-validation-for="NewPolicyType.LifeAssuredMinAge" class="text-danger"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="NewPolicyType.LifeAssuredMaxAge" class="control-label"><h6>Life Assured Max Age</h6></label>
                <input asp-for="NewPolicyType.LifeAssuredMaxAge" min="0" max="150" required class="form-control" />
                <span asp-validation-for="NewPolicyType.LifeAssuredMaxAge" class="text-danger"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="NewPolicyType.ProposerMinAge" class="control-label"><h6>Proposer Min Age</h6></label>
                <input asp-for="NewPolicyType.ProposerMinAge" min="0" max="150" required class="form-control" />
                <span asp-validation-for="NewPolicyType.ProposerMinAge" class="text-danger"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="NewPolicyType.ProposerMaxAge" class="control-label"><h6>Proposer Max Age</h6></label>
                <input asp-for="NewPolicyType.ProposerMaxAge" min="0" max="150" required class="form-control" />
                <span asp-validation-for="NewPolicyType.ProposerMaxAge" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-sm-3">
                <label asp-for="NewPolicyType.PremiumPayerMinAge" class="control-label"><h6>Premium Payer Min Age</h6></label>
                <input asp-for="NewPolicyType.PremiumPayerMinAge" min="0" max="150" required class="form-control" />
                <span asp-validation-for="NewPolicyType.PremiumPayerMinAge" class="text-danger"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="NewPolicyType.PremiumPayerMaxAge" class="control-label"><h6>Premium Payer Max Age</h6></label>
                <input asp-for="NewPolicyType.PremiumPayerMaxAge" min="0" max="150" required class="form-control" />
                <span asp-validation-for="NewPolicyType.PremiumPayerMaxAge" class="text-danger"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="NewPolicyType.MinimumTerm" class="control-label"><h6>Minimum Term</h6></label>
                <input asp-for="NewPolicyType.MinimumTerm" min="0" max="150" required class="form-control" />
                <span asp-validation-for="NewPolicyType.MinimumTerm" class="text-danger"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="NewPolicyType.MaximumTerm" class="control-label"><h6>Maximum Term</h6></label>
                <input asp-for="NewPolicyType.MaximumTerm" min="0" max="150" required class="form-control" />
                <span asp-validation-for="NewPolicyType.MaximumTerm" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-sm-4">
                <label asp-for="NewPolicyType.OpenForNewBusiness" class="control-label"><h6>Open For New Business</h6></label>
                <select asp-for="NewPolicyType.OpenForNewBusiness" min="0" max="150" required class="form-control" aria-required="true">
                    <option value="">Select Option</option>
                    <option value=0>Closed</option>
                    <option value=1>Open</option>
                </select>
                <span asp-validation-for="NewPolicyType.OpenForNewBusiness" class="text-danger"></span>
            </div>
            <div class="col-sm-4">
                <label asp-for="NewPolicyType.CurrencyID" class="control-label"><h6>Currency</h6></label>
                <select asp-for="NewPolicyType.CurrencyID" required class="form-control" asp-items="Model.Currencies"></select>
                <span asp-validation-for="NewPolicyType.CurrencyID" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-sm-4">
                <label asp-for="NewPolicyType.AllowDeferingOfMaturityDate" class="control-label"><h6>Defering Of Maturity Date</h6></label>
                <select asp-for="NewPolicyType.AllowDeferingOfMaturityDate" required class="form-control" aria-required="true">
                    <option value="">Select Option</option>
                    <option value=0>Do not allow</option>
                    <option value=1>Allow</option>
                </select>
                <span asp-validation-for="NewPolicyType.AllowDeferingOfMaturityDate" class="text-danger"></span>
            </div>
            <div class="col-sm-2">
                <label asp-for="NewPolicyType.DefermentNoticePeriod" class="control-label"><h6>Notice Period (Days)</h6></label>
                <input asp-for="NewPolicyType.DefermentNoticePeriod" required min="0" class="form-control" />
                <span asp-validation-for="NewPolicyType.DefermentNoticePeriod" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-primary btn-sm" />
            <a class="btn btn-success btn-sm" asp-page="Index">View Full List</a>
           @*  <a asp-page="Edit" asp-route-id="@Model.NewPolicyType?.ID" class="btn btn-outline-primary btn-sm">Edit</a>
            <a asp-page="Products" asp-route-id="@Model.NewPolicyType?.ID" class="btn btn-outline-success btn-sm">Products</a>
            <a asp-page="Documents" asp-route-id="@Model.NewPolicyType?.ID" class="btn btn-outline-info btn-sm">Documents</a>
            <a asp-page="Details" asp-route-id="@Model.NewPolicyType?.ID" class="btn btn-info btn-sm">Details</a>
            <a asp-page="Benefits" asp-route-id="@Model.NewPolicyType?.ID" class="btn btn-success btn-sm">Benefits</a> *@
        </div>
    </form>
</div>