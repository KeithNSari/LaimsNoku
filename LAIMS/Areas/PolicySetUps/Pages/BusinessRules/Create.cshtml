@page
@using System.Data
@model LAIMS.Areas.PolicySetUps.Pages.BusinessRules.CreateModel
@{
}
@{
    Layout = "/Pages/Shared/_LayoutProducts.cshtml";
}
<h2>Add Business Rules</h2>
<hr />
@if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
{
    <p class="text-danger">@ViewData["ErrorMessage"]</p>
}
<div class="row mb-3">
    <form method="post"> 
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="@Model.BusinessRule.StoredProcedure" class="control-label"><b>Stored Procedure</b></label>
                <select asp-for="@Model.BusinessRule.StoredProcedure" required class="form-control" asp-items="Model.StoredProcsList">
                    <option value="">Select A Procedure</option>
                </select>
                <span asp-validation-for="@Model.BusinessRule.StoredProcedure" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="@Model.BusinessRule.RuleName" class="control-label"><b>Rule Name</b></label>
                <input asp-for="@Model.BusinessRule.RuleName" required class="form-control" />
                <span asp-validation-for="@Model.BusinessRule.RuleName" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>
<div class="row mb-3">
    <h4>Current Rules</h4>
    <form method="post"> 
        <table class="table table-striped">
            <tr>
                <th>No</th>
                <th>Rule Name</th>
                <th>Stored Procedure</th> 
                <th></th>
            </tr>
            @if (Model.BusinessRulesDT != null)
            {
                @foreach (DataRow DR in Model.BusinessRulesDT.Rows)
                {
                    <tr>
                        <td>@DR["RowNo"]</td>
                        <td>@DR["RuleName"]</td>
                        <td>@DR["StoredProcedure"]</td> 
                        <td class="text-end">
                            <button type="submit" asp-route-id="@DR["ID"]" asp-page-handler="Remove" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to remove this item?');">Remove</button>
                        </td>
                    </tr>
                }
            }
        </table>
    </form>
</div> 