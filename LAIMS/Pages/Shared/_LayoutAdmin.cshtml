<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<title>LCS</title>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="description" content="">
	<meta name="author" content="">
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

	<!-- ================== BEGIN core-css ================== -->
	<link href="~/assets/css/vendor.min.css" rel="stylesheet">
	<link href="~/assets/css/app.min.css" rel="stylesheet">
	<!-- ================== END core-css ================== -->
    <link rel="stylesheet" href="~/css/tab.css" asp-append-version="true" />
	<style> 
		.black-text {
			color: black; /* Change the color to your desired value */
		}
	</style>
	<style>
		.fixed-width-btn {
			width: 200px;
		}
	</style>
	<style>
		.fixed-width{
			width: 200px;
		}
	</style>
	<style>
		.inlineblockmbs{
			display: inline-block;
			margin-right: 10px; /* Optional: Add some margin between the forms */
		}
	</style>
	<style>
    .max-height-400 {
     max-height: 400px;
    }
	</style>
	<style> 
		.custom-nav-tabs .nav-item.active .nav-link {
			background-color: white;
		}
	</style>
</head>
<body>
	<!-- BEGIN #app -->
	<div id="app" class="app">
		<!-- BEGIN #header -->
		<div id="header" class="app-header">
			<!-- BEGIN mobile-toggler -->
			<div class="mobile-toggler">
				<button type="button" class="menu-toggler" data-toggle="sidebar-mobile">
					<span class="bar"></span>
					<span class="bar"></span>
				</button>
			</div>
			<!-- END mobile-toggler -->
			<!-- BEGIN brand -->
			<div class="brand">
				<div class="desktop-toggler">
					<button type="button" class="menu-toggler" data-toggle="sidebar-minify">
						<span class="bar"></span>
						<span class="bar"></span>
					</button>
				</div>

				<h2>LCS</h2>
			</div>
			<!-- END brand -->
			<!-- BEGIN menu -->
			<div class="menu">
				<form class="menu-search" name="header_search_form">
					<div class="menu-search-icon"><i class="fa fa-search"></i></div>
					<div class="menu-search-input">
						<input type="text" class="form-control" placeholder="Search menu...">
					</div>
				</form> 
				<div class="menu-item dropdown">
					<a href="#" data-bs-toggle="dropdown" data-display="static" class="menu-link">						 
						<div class="menu-text"> 
								 @User.Identity?.Name 
						</div>
					</a>
					<div class="dropdown-menu dropdown-menu-end me-lg-3">						 
						<a class="dropdown-item d-flex align-items-center" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="~/Index">Log Out <i class="fa fa-toggle-off fa-fw ms-auto text-body text-opacity-50"></i></a>
					</div>
				</div>
			</div>
			<!-- END menu -->
		</div>
		<!-- END #header -->
		<!-- BEGIN #sidebar -->
		<div id="sidebar" class="app-sidebar">
			<!-- BEGIN scrollbar -->
			<div class="app-sidebar-content" data-scrollbar="true" data-height="100%">
				<!-- BEGIN menu -->
				<div class="menu">
					<div class="menu-header">Quick View</div>
					<div class="menu-item">
						<a asp-page="/Index" class="menu-link">
							<span class="menu-icon"><i class="fa fa-laptop"></i></span>
							<span class="menu-text">Dashboard</span>
						</a>
					</div> 
					<div class="menu-divider"></div>
					<div class="menu-header">Administration</div>
					<div class="menu-item">
						<a asp-page="/adm/CreateSingleUser" class="menu-link">
							<span class="menu-icon"><i class="fa fa-qrcode"></i></span>
							<span class="menu-text">Single Users</span>
						</a>
					</div>
					<div class="menu-item">
						<a asp-page="/adm/UploadUsers" class="menu-link">
							<span class="menu-icon"><i class="fa fa-qrcode"></i></span>
							<span class="menu-text">Upload Users</span>
						</a>
					</div>
					<div class="menu-item">
						<a asp-page="/adm/RolesEdit" class="menu-link">
							<span class="menu-icon"><i class="fa fa-qrcode"></i></span>
							<span class="menu-text">Roles Edit</span>
						</a>
					</div>
					<div class="menu-item">
						<a asp-page="/adm/ResetUser" class="menu-link">
							<span class="menu-icon"><i class="fa fa-qrcode"></i></span>
							<span class="menu-text">Reset User</span>
						</a>
					</div>
					<div class="menu-divider"></div>
					<div class="menu-header">Users</div>
					<div class="menu-item">
						<a href="/identity/Account/myprofile" class="menu-link">
							<span class="menu-icon"><i class="fa fa-user-circle"></i></span>
							<span class="menu-text">Profile</span>
						</a>
					</div> 
				</div>
				<!-- END menu -->
			</div>
			<!-- END scrollbar -->
			<!-- BEGIN mobile-sidebar-backdrop -->
			<button class="app-sidebar-mobile-backdrop" data-dismiss="sidebar-mobile"></button>
			<!-- END mobile-sidebar-backdrop -->
		</div>
		<!-- END #sidebar -->
		<!-- BEGIN #content -->
		<div id="content" class="app-content">
			<!-- BEGIN container -->
			<div class="container">
				<!-- BEGIN row -->
				@* <main role="main" class="pb-3"> *@
					@RenderBody()
				@* </main> *@

				<!-- END row -->
			</div>
			<!-- END container -->
		</div>
		<!-- END #content -->
		<!-- BEGIN btn-scroll-top -->
		<a href="#" data-click="scroll-top" class="btn-scroll-top fade"><i class="fa fa-arrow-up"></i></a>
		<!-- END btn-scroll-top -->  
	</div>
	<!-- END #app -->
	<!-- ================== BEGIN core-js ================== -->
	<script src="~/assets/js/vendor.min.js"></script>
	<script src="~/assets/js/app.min.js"></script>
	<!-- ================== END core-js ================== -->
	<!-- ================== BEGIN page-js ================== -->
	<script src="~/assets/plugins/highlightjs/cdn-assets/highlight.min.js"></script>
	<script src="~/assets/js/demo/highlightjs.demo.js"></script>
	<script src="~/assets/js/demo/sidebar-scrollspy.demo.js"></script>

	@* <script src="~/assets/plugins/apexcharts/dist/apexcharts.min.js"></script>
	<script src="~/assets/js/demo/dashboard.demo.js"></script> *@
	<!-- ================== END page-js ================== -->

</body>
</html>
@await RenderSectionAsync("Scripts", required: false) 